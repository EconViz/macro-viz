    "parity.curve.parity": "$IP$",
    "parity.mark.foreign_rate": "$i^*$",
    "parity.mark.expected": "$E^e$",
    "parity.mark.exchange": "$E$",
    "parity.mark.rate": "$i$"
  }
}
